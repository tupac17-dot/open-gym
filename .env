# Hostname passkeys are bound to (localhost for local dev, or your domain like gym.example.com)
RP_ID=localhost

# Full URL the app is served from (single origin)
ORIGIN=http://localhost:8080

# Host port for the web UI
WEB_PORT=8080

# Name shown in the passkey prompt
RP_NAME=openGym

# User IDs that get the admin dashboard (comma-separated, optional)
ADMIN_UIDS=zW3tMCTdhs8GQLEq

# Require an invite code to create a profile (1/true to enable, optional)
INVITE_ONLY=1
